{
    "name": "@ef-global/agentic-core",
    "version": "0.0.1",
    "description": "Essential primitives and utilities for building agentic workflows",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "type-check": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "check": "npm run type-check && npm run lint",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "ai",
        "agent",
        "agentic",
        "workflow",
        "primitives",
        "utilities"
    ],
    "author": "EF HQ",
    "license": "MIT",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@types/node": "^20.11.17",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.2.5",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18"
    }
}